# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/

# Virtual environments (any name)
.venv*/
venv*/
env/
ENV/

# Secrets & credentials — never commit these
.env
.env.*
*.key
*.pem
*.token
secrets.yaml
credentials.*

# Run artifacts hold adversarial content AND findings about a real system —
# often someone else's. Never commit them. See RESPONSIBLE_USE.md.
*.db
*.db-wal
*.db-shm
*report.html
*.sarif
findings.json

# Local configs may contain endpoints, tokens, or lab scope — keep them local
*.local.yaml
config/local.yaml
config/*.local.yaml

# OS junk
.DS_Store
Thumbs.db
